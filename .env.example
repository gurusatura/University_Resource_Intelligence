# ==============================================================================
# University Resource Intelligence System — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and replace with your actual credentials:
# cp .env.example .env

# PostgreSQL Database Connection URL (Supabase or local PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Groq API Key (Free tier from https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here
